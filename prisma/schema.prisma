generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ Users ============
model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  role           String   @default("CUSTOMER") // CUSTOMER | CREATOR
  bio            String?
  avatarColor    String   @default("emerald") // gradient key for avatar
  discordHandle  String?
  telegramHandle String?
  isDemo         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products         Product[]
  subscriptions    Subscription[]
  paymentMethods   PaymentMethod[]
  invoices         Invoice[]
  licenses         LicenseKey[]
  accessGrants     AccessGrant[]
  downloadTokens   DownloadToken[]
  webhookEndpoints WebhookEndpoint[]
  promoCodes       PromoCode[]
  wishlistItems    WishlistItem[]
  notifications    Notification[]
  payouts          Payout[]
  affiliatePrograms AffiliateProgram[]
  affiliateLinks   AffiliateLink[]
  affiliateCommissions AffiliateCommission[]
  giveaways        Giveaway[]
  giveawayEntries  GiveawayEntry[]
  questions        Question[]
  answers          Answer[]
  questionVotes    QuestionVote[]
  bundles          Bundle[]
  bundlePurchases  BundlePurchase[]
}

// ============ Catalog ============
model Product {
  id           String   @id @default(cuid())
  creatorId    String
  creator      User     @relation(fields: [creatorId], references: [id])
  slug         String   @unique
  title        String
  tagline      String?
  description  String
  category     String   @default("OTHER") // TRADING | SAAS | CRYPTO | FITNESS | DESIGN | EDUCATION | GAMING | OTHER
  coverTheme   String   @default("emerald") // gradient theme key
  accessType   String   @default("LINK") // comma list: DISCORD,TELEGRAM,LICENSE,FILE
  status       String   @default("ACTIVE") // ACTIVE | PAUSED
  featured     Boolean  @default(false)
  membersCount Int      @default(0)
  rating       Float    @default(0)
  reviewCount  Int      @default(0)
  discordRoleName String?
  telegramChannel String?
  // Default access policy for FULL refunds issued on this product's invoices:
  // REVOKE       — cancel the membership and revoke roles/licenses immediately
  // KEEP_ACCESS  — goodwill policy: buyer keeps access until currentPeriodEnd
  refundPolicy String   @default("REVOKE") // REVOKE | KEEP_ACCESS
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  plans         Plan[]
  subscriptions Subscription[]
  licenses      LicenseKey[]
  assets        DigitalAsset[]
  accessGrants  AccessGrant[]
  reviews       Review[]
  promoCodes    PromoCode[]
  wishlistItems WishlistItem[]
  affiliateProgram AffiliateProgram?
  giveaways      Giveaway[]
  questions     Question[]
  bundleItems   BundleItem[]
}

// ============ Bundles ============
model Bundle {
  id          String   @id @default(cuid())
  creatorId   String
  creator     User     @relation(fields: [creatorId], references: [id])
  slug        String   @unique
  title       String
  description String?
  discountPct Int      // 5-50 percent off each included plan
  coverTheme  String   @default("emerald")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items     BundleItem[]
  purchases BundlePurchase[]
}

model BundleItem {
  id        String  @id @default(cuid())
  bundleId  String
  bundle    Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  planId    String  // the designated plan of this product included in the bundle
  plan      Plan    @relation(fields: [planId], references: [id])
  sortOrder Int     @default(0)

  @@unique([bundleId, productId])
}

model BundlePurchase {
  id            String   @id @default(cuid())
  bundleId      String
  bundle        Bundle   @relation(fields: [bundleId], references: [id])
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  subtotalCents Int
  discountCents Int
  totalCents    Int
  gateway       String   // STRIPE | PAYPAL | WHOP
  whopRef       String?  @unique // Whop payment id (pay_…) — idempotency key for whop bundle checkouts
  createdAt     DateTime @default(now())
}

model Plan {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  name        String
  description String?
  priceCents  Int
  currency    String   @default("usd")
  interval    String   @default("month") // month | year
  trialDays   Int      @default(0)
  badge       String?
  features    String   @default("[]") // JSON array of strings
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  subscriptions Subscription[]
  bundleItems  BundleItem[]
}

// ============ Billing ============
model Subscription {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  planId            String
  plan              Plan      @relation(fields: [planId], references: [id])
  productId         String
  product           Product   @relation(fields: [productId], references: [id])
  status            String    @default("ACTIVE") // TRIALING | ACTIVE | PAST_DUE | CANCELED | PENDING
  gateway           String    // STRIPE | PAYPAL | CRYPTO
  paymentMethodId   String?
  paymentMethod     PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd  DateTime
  cancelAtPeriodEnd Boolean   @default(false)
  canceledAt        DateTime?
  trialEndsAt       DateTime?
  dunningAttempts    Int       @default(0)
  // A Whop off-session charge (pay_…) that was created but had not settled
  // when the billing run ended (slow processing / 3DS). The next run checks
  // this payment FIRST instead of creating another charge — double-charge
  // protection for real renewals. The ref is parked on the row IMMEDIATELY
  // after the charge is created (before settlement polling), so a crash
  // between “charge created” and “charge settled” can never double-charge.
  pendingWhopRef     String?
  // Platform-clock moment the ref above was parked. A charge stuck in
  // requires_action/processing for > 3 days is resolved as failed (buyer
  // must update their card) instead of deferring the renewal forever.
  pendingWhopRefAt   DateTime?
  promoCodeId        String?
  promoCyclesUsed    Int       @default(0) // how many invoices the promo discount has been applied to
  refLinkId          String?   // affiliate link that referred this subscription (attribution)
  bundleId           String?   // bundle origin — renewals charge the discounted price persistently (snapshot, no relation)
  bundleTitle        String?
  bundleDiscountPct  Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  invoices Invoice[]
  licenses LicenseKey[]
}

model PaymentMethod {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  type          String   // CARD | PAYPAL | CRYPTO
  gateway       String   // STRIPE | PAYPAL | CRYPTO
  brand         String?
  last4         String?
  expMonth      Int?
  expYear       Int?
  email         String?
  walletAddress String?
  chain         String?
  // Whop saved-card references (Whop Elements checkouts): the tokenized
  // payment method (payt_…) and the Whop member (mber_…) it belongs to.
  // Both are required to charge the card off-session (renewals/trial
  // conversion) through the real Whop API.
  whopPaymentMethodId String?
  whopMemberId        String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())

  subscriptions Subscription[]
}

model Invoice {
  id             String    @id @default(cuid())
  number         String    @unique // INV-1001
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  productId      String?
  description    String
  amountCents    Int
  currency       String    @default("usd")
  status         String    @default("PAID") // PAID | FAILED | REFUNDED | OPEN
  gateway        String?
  discountCents  Int       @default(0) // promo discount applied to this invoice
  promoCode      String?   // the code applied, for display
  refundedCents  Int       @default(0) // cumulative refunded amount (partial refunds)
  periodStart    DateTime?
  periodEnd      DateTime?
  paidAt         DateTime?
  refundedAt     DateTime?
  whopRef        String?   // Whop payment id (pay_…) when charged via Whop Elements
  createdAt      DateTime  @default(now())
}

// ============ Fulfillment ============
model LicenseKey {
  id             String    @id @default(cuid())
  key            String    @unique
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  productId      String
  product        Product   @relation(fields: [productId], references: [id])
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  status         String    @default("ACTIVE") // ACTIVE | REVOKED | EXPIRED
  planName       String?
  activations    Int       @default(0)
  maxActivations Int       @default(3)
  activatedAt    DateTime?
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
}

model DigitalAsset {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  name            String
  fileName        String
  mimeType        String   @default("text/plain")
  sizeBytes       Int      @default(2048)
  content         String   @default("")
  version         String   @default("1.0")
  requiresLicense Boolean  @default(false)
  downloadCount   Int      @default(0)
  createdAt       DateTime @default(now())

  tokens DownloadToken[]
}

model DownloadToken {
  id        String       @id @default(cuid())
  token     String       @unique
  assetId   String
  asset     DigitalAsset @relation(fields: [assetId], references: [id])
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  expiresAt DateTime
  uses      Int          @default(0)
  maxUses   Int          @default(3)
  createdAt DateTime     @default(now())
}

model AccessGrant {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  productId String
  product   Product   @relation(fields: [productId], references: [id])
  provider  String    // DISCORD | TELEGRAM | LICENSE | FILE
  role      String?
  status    String    @default("SYNCED") // PENDING | SYNCED | REVOKED | FAILED
  grantedAt DateTime  @default(now())
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

// ============ Webhooks ============
model WebhookEndpoint {
  id        String   @id @default(cuid())
  creatorId String
  creator   User     @relation(fields: [creatorId], references: [id])
  name      String
  provider  String   @default("GENERIC") // DISCORD_BOT | TELEGRAM_BOT | GENERIC
  url       String
  secret    String
  events    String   @default("[]") // JSON array of event types
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  deliveries WebhookDelivery[]
}

model WebhookDelivery {
  id           String         @id @default(cuid())
  endpointId   String
  endpoint     WebhookEndpoint @relation(fields: [endpointId], references: [id])
  eventType    String
  payload      String         @default("{}")
  status       String         @default("PENDING") // PENDING | DELIVERED | FAILED
  attempts     Int            @default(0)
  responseCode Int?
  signature    String?
  createdAt    DateTime       @default(now())
  deliveredAt  DateTime?
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  userId     String
  authorName String
  rating     Int
  comment    String
  createdAt  DateTime @default(now())
}

// ============ System ============
model SystemClock {
  id          String    @id @default("main")
  simulatedNow DateTime?
  // Real timestamp at which `simulatedNow` was captured. The platform clock
  // keeps ticking in lock-step with real time from that instant:
  //   now = simulatedNow + (realNow - simulatedSetAt)
  // so a +30d jump stays exactly 30d ahead instead of freezing.
  simulatedSetAt DateTime?
  label       String    @default("Live")
  updatedAt   DateTime  @updatedAt
}

// ============ Promotions ============
model PromoCode {
  id             String   @id @default(cuid())
  creatorId      String
  creator        User     @relation(fields: [creatorId], references: [id])
  productId      String?  // null = applies to every product the creator owns
  product        Product? @relation(fields: [productId], references: [id])
  code           String   @unique
  kind           String   @default("PERCENT") // PERCENT | FIXED
  value          Int      // percent (1-100) when PERCENT, cents when FIXED
  maxRedemptions Int      @default(0) // 0 = unlimited
  timesRedeemed  Int      @default(0)
  durationMonths Int      @default(1) // billing cycles the discount applies to
  expiresAt      DateTime?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  redemptions PromoRedemption[]
}

model PromoRedemption {
  id             String     @id @default(cuid())
  promoId        String
  promo          PromoCode  @relation(fields: [promoId], references: [id])
  userId         String
  subscriptionId String
  invoiceId      String?
  discountCents  Int
  createdAt      DateTime  @default(now())
}

// ============ Engagement ============
model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String   // invoice_paid | payment_failed | past_due | subscription_created | subscription_canceled | subscription_renewed | trial_converted | license_created | review_new | promo_redeemed | payout_paid | payout_pending
  title     String
  body      String?
  icon      String   @default("bell") // receipt | alert | user-plus | x-circle | refresh | key | star | tag | bank | gift | message
  read      Boolean  @default(false)
  productId String?   // optional context: product the notification points at (Q&A deep links)
  createdAt DateTime @default(now())
}

// ============ Creator payouts ============
model Payout {
  id          String    @id @default(cuid())
  creatorId   String
  creator     User      @relation(fields: [creatorId], references: [id])
  amountCents Int       // net amount paid out to the creator
  feeCents    Int       @default(0) // platform fee withheld for this payout period
  status      String    @default("PENDING") // PENDING | PAID
  method      String    @default("BANK") // BANK | PAYPAL | CRYPTO
  createdAt   DateTime  @default(now())
  paidAt      DateTime?
}

// ============ Affiliates & referrals ============
model AffiliateProgram {
  id            String    @id @default(cuid())
  productId     String    @unique
  product       Product   @relation(fields: [productId], references: [id])
  creatorId     String
  creator       User      @relation(fields: [creatorId], references: [id])
  commissionBps Int       @default(3000) // 30% = 3000 basis points of the first invoice
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  links        AffiliateLink[]
}

model AffiliateLink {
  id          String    @id @default(cuid())
  code        String    @unique // shareable slug, e.g. "alex" or "k7m2xq"
  userId      String    // the affiliate promoting the product
  user        User      @relation(fields: [userId], references: [id])
  programId   String
  program     AffiliateProgram @relation(fields: [programId], references: [id])
  clicks      Int       @default(0)
  conversions Int       @default(0)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  commissions AffiliateCommission[]

  @@unique([userId, programId])
}

model AffiliateCommission {
  id             String    @id @default(cuid())
  linkId         String
  link           AffiliateLink @relation(fields: [linkId], references: [id])
  affiliateId    String
  affiliate      User      @relation(fields: [affiliateId], references: [id])
  creatorId      String
  productId      String
  subscriptionId String
  amountCents    Int       // commission earned from the referred first invoice
  status         String    @default("PENDING") // PENDING | PAID
  createdAt      DateTime  @default(now())
  paidAt         DateTime?
}

// ============ Giveaways & drops ============
model Giveaway {
  id              String   @id @default(cuid())
  creatorId       String
  creator         User     @relation(fields: [creatorId], references: [id])
  productId       String?  // optional product the drop promotes
  product         Product? @relation(fields: [productId], references: [id])
  title           String
  description     String
  prize           String   // what the winner(s) receive
  prizeValueCents Int      @default(0) // display only
  coverTheme      String   @default("emerald") // gradient key
  status          String   @default("LIVE") // LIVE | ENDED
  endsAt          DateTime
  winnerCount     Int      @default(1)
  memberBonus     Int      @default(2) // extra entries for active members of the linked product
  drawnAt         DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  entries GiveawayEntry[]
}

model GiveawayEntry {
  id         String   @id @default(cuid())
  giveawayId String
  giveaway   Giveaway @relation(fields: [giveawayId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  entries    Int      @default(1) // 1 + memberBonus when the entrant is an active member
  won        Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([giveawayId, userId])
}

// ============ Product Q&A ============
model Question {
  id        String   @id @default(cuid())
  productId String
  authorId  String
  body      String
  status    String   @default("OPEN") // OPEN | ANSWERED
  createdAt DateTime @default(now())

  product  Product         @relation(fields: [productId], references: [id])
  author   User            @relation(fields: [authorId], references: [id])
  answers  Answer[]
  votes    QuestionVote[]
}

model Answer {
  id         String   @id @default(cuid())
  questionId String
  authorId   String
  body       String
  isCreator  Boolean  @default(false)
  createdAt  DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id])
  author   User     @relation(fields: [authorId], references: [id])
}

model QuestionVote {
  id         String   @id @default(cuid())
  questionId String
  userId     String
  createdAt  DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([questionId, userId])
}

// ============ System integrity primitives ============

// Immutable audit trail for money-moving and lifecycle events — every charge,
// renewal, decline, refund, cancel and webhook reconciliation lands here with
// the platform clock timestamp, the actor and the amounts involved. The
// creator studio surfaces this as a read-only "Audit log" feed.
model AuditLog {
  id             String   @id @default(cuid())
  at             DateTime // platform clock (getNow()), not wall time
  actorId        String   @default("system") // user id | "system" | "worker" | "whop"
  action         String // charge.succeeded | charge.failed | refund.created | subscription.canceled | trial.converted | comp.renewal | webhook.reconciled | rate.limited | …
  gateway        String?
  amountCents    Int      @default(0)
  invoiceId      String?
  subscriptionId String?
  whopRef        String?  // pay_… when the event ran through Whop
  detail         String   @default("{}") // JSON: error messages, reasons, actors…
  createdAt      DateTime @default(now())

  @@index([at])
  @@index([action])
}

// Whop webhook ingestion dedupe — every accepted webhook event id is recorded
// exactly once (unique constraint); replays are acknowledged but skipped.
// `outcome` tracks what reconciliation did with the event so the creator
// studio can surface it (received → reconciled | noop | unmatched | no-rule |
// | error) and `outcomeDetail` carries a human note; unmatched/error rows can
// be re-reconciled manually once the missing invoice has landed.
model WhopEvent {
  id            String   @id @default(cuid())
  eventId       String   @unique // Whop's event id (evt_…)
  type          String // payment.succeeded | payment.failed | …
  at            DateTime // platform clock when ingested
  payload       String   @default("{}")
  processed     Boolean  @default(true)
  outcome       String   @default("received") // received | reconciled | noop | unmatched | no-rule | error
  outcomeDetail String   @default("")
  createdAt     DateTime @default(now())
}

// Monotonic counters — minted with a single atomic UPDATE (SQLite serializes
// writers), so concurrent checkouts and billing-engine runs can never mint
// the same value. Currently used for invoice numbers (id: "invoice").
model Counter {
  id    String @id
  value Int    @default(0)
}

// Advisory DB locks — cross-process mutual exclusion for critical sections
// that must never overlap (the billing engine run, per-user checkout
// provisioning). Acquire = atomic UPDATE with a staleness cutoff; a lock held
// past its TTL is considered abandoned (crashed holder) and can be taken over.
model AdvisoryLock {
  name      String    @id
  lockedAt  DateTime?
  owner     String    @default("")
  updatedAt DateTime  @updatedAt
}

// Durable history of recurring-worker billing runs. The worker mini-service
// ticks on a schedule and fires POST /api/billing/tick, which runs the billing
// engine and records a row here. The time machine also records its runs.
model WorkerRun {
  id               String   @id @default(cuid())
  source           String   @default("WORKER") // WORKER | MANUAL | TIME_MACHINE
  startedAt        DateTime @default(now())
  // Real wall-clock moment the row was written. `startedAt` follows the
  // (possibly simulated) platform clock, so ordering/trimming by it breaks
  // after a clock reset — future-dated runs would monopolize the history and
  // evict fresh live runs. Ordering and retention use THIS column instead.
  recordedAt       DateTime @default(now())
  durationMs       Int      @default(0)
  renewals         Int      @default(0)
  renewalsFailed   Int      @default(0)
  canceled         Int      @default(0)
  trialsConverted  Int      @default(0)
  invoicesCreated  Int      @default(0)
  events           String   @default("[]") // JSON string array
  error            String?
}
